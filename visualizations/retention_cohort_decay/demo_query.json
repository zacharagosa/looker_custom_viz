{
  "model": "void_weaver_analytics",
  "view": "player_retention_curve",
  "fields": [
    "player_retention_curve.cohort_week",
    "player_retention_curve.retention_day",
    "player_retention_curve.retained_players"
  ],
  "sorts": [
    "player_retention_curve.cohort_week asc",
    "player_retention_curve.retention_day asc"
  ],
  "limit": "500",
  "vis_config": {
    "type": "retention_cohort_decay",
    "viewMode": "split_view",
    "valueDisplay": "retention_pct",
    "periodZeroHandling": "index_100",
    "showBenchmark": true,
    "showLabels": true,
    "colorTheme": "indigo_violet"
  }
}
