{
  "model": "thelook",
  "view": "order_items",
  "fields": [
    "products.category",
    "order_items.created_year",
    "order_items.total_sale_price"
  ],
  "pivots": [
    "order_items.created_year"
  ],
  "filters": {
    "order_items.created_year": "2023,2024,2025,2026"
  },
  "sorts": [
    "order_items.created_year asc 0",
    "products.category"
  ],
  "limit": "25",
  "vis_config": {
    "type": "dynamic_pivot_matrix",
    "renderMode": "matrix_bars",
    "colorPalette": "google_modern",
    "hudMode": "full",
    "targetMode": "dataset_mean",
    "targetLabel": "Overall Mean",
    "highlightTargetBreaches": true,
    "anomalyThreshold": 20,
    "sortOrder": "metric_desc",
    "dataLabelDensity": "all",
    "showRowTotals": true,
    "showColTotals": true,
    "showSearch": true,
    "pageSize": "10",
    "valueFormat": "compact_currency",
    "highlightMaxCell": true,
    "fontSize": "standard"
  }
}