{
  "model": "zayo_network_analytics",
  "view": "optical_telemetry_and_predictive_maintenance",
  "fields": [
    "optical_span_anomalies.timestamp_date",
    "optical_span_anomalies.avg_attenuation_db_per_km",
    "optical_span_anomalies.avg_osnr_db",
    "optical_span_anomalies.count"
  ],
  "sorts": [
    "optical_span_anomalies.timestamp_date asc"
  ],
  "limit": "30",
  "vis_config": {
    "type": "zayo_optical_spectrum_waterfall",
    "custom_title": "DWDM Optical Attenuation & Telemetry Spectrum Analyzer",
