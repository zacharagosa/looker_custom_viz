    "referenceLineLabel": "ITU-T Anomaly Threshold",
    "alertThreshold": 0.25,
    "sortOrder": "natural",
    "topNLimit": "all",
    "enableOtherRollup": false,
    "suppressNulls": true,
    "labelDensity": "peaks_only",
    "showSearchBar": true,
    "colorPalette": "zayo_telecom",
    "metricPolarity": "lower_is_better",
    "fontScale": "standard",
    "valueFormat": "decimal_3"
  }
}
