{
  "model": "void_weaver_analytics",
  "view": "level_progression_telemetry",
  "fields": [
    "level_progression_telemetry.campaign_level",
    "level_progression_telemetry.surviving_players",
    "level_progression_telemetry.total_boss_wipes"
  ],
  "sorts": [
    "level_progression_telemetry.campaign_level asc"
  ],
  "limit": "500",
  "vis_config": {
    "type": "level_progression_balance_curve",
    "curveLayout": "dual_axis_spikes",
    "chokePointSensitivity": "medium",
    "showExecutiveHUD": true,
    "showChokePointBadges": true,
    "showDataLabels": true,
    "showSearch": true,
    "colorTheme": "executive_slate",
    "curveSmoothing": "catmull_rom",
    "areaOpacity": "medium",
    "valueFormat": "compact_num",
    "highlightWorstChoke": true
  }
}
