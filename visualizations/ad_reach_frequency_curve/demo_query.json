{
  "model": "tvun_media_analytics",
  "view": "ad_spot_airings",
  "fields": [
    "broadcast_programming.network",
    "ad_spot_airings.total_airing_spots",
    "nielsen_ratings_markets.total_grps",
    "ad_spot_airings.total_spend_mxn"
  ],
  "sorts": [
    "nielsen_ratings_markets.total_grps desc"
  ],
  "limit": "500",
  "vis_config": {
    "type": "ad_reach_frequency_curve",
    "layoutMode": "reach_frequency_curve",
    "showExecutiveHUD": true,
    "targetReachGoal": 70,
    "effectiveFrequencyMin": 3,
    "effectiveFrequencyMax": 6,
    "modelFittingEngine": "bimodal_mbb",
    "showDiminishingReturnInflection": true,
    "showSearch": true,
    "colorTheme": "google_enterprise",
    "curveSmoothing": "monotone",
    "showGridlines": true,
    "valueFormat": "compact_num"
  }
}
