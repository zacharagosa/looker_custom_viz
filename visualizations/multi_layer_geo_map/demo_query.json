{
  "model": "thelook",
  "view": "order_items",
  "fields": [
    "users.state",
    "order_items.total_sale_price",
    "order_items.total_gross_margin",
    "order_items.order_count"
  ],
  "sorts": [
    "order_items.total_sale_price desc"
  ],
  "limit": "500",
  "vis_config": {
    "type": "multi_layer_geo_map",
    "mapMode": "dual_layer",
    "stateDimOverride": "",
    "choroplethMeasureOverride": "",
    "bubbleMeasureOverride": "",
    "tertiaryMeasureOverride": "",
    "targetCalculationMode": "percentile_p75",
    "referenceLineLabel": "P75 Target Benchmark",
    "alertThreshold": 20,
    "sortOrder": "metric_desc",
    "topN": "all",
    "suppressNulls": false,
    "hudMode": "full",
    "labelDensity": "all",
    "showDualLegend": true,
    "showSearch": true,
    "colorTheme": "google_enterprise",
    "polarity": "higher_better",
    "fontScale": "standard",
    "valueFormat1": "auto",
    "valueFormat2": "auto",
    "bubbleScale": 1.2,
    "choroplethOpacity": 0.85
  }
}
