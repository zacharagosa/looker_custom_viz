{
  "model": "zayo_network_analytics",
  "view": "network_operations_and_anomalies",
  "fields": [
    "fiber_routes.origin_city",
    "fiber_routes.dest_city",
    "route_traffic_anomalies.avg_bandwidth_utilization_gbps",
    "route_traffic_anomalies.avg_utilization_pct",
    "route_traffic_anomalies.total_anomalies_detected"
  ],
  "sorts": [
    "route_traffic_anomalies.avg_bandwidth_utilization_gbps desc"
  ],
  "limit": "500",
  "vis_config": {
    "type": "network_topology_graph",
    "viewMode": "force_directed",
    "flowAnimation": "pulse",
    "nodeSizing": "volume",
    "edgeMetric": "latency",
    "colorTheme": "cyber_dark",
    "showExecutiveHUD": true,
    "showSearch": true,
    "showLabels": "always",
    "valueFormat": "bandwidth",
    "baseNodeRadius": 15,
    "linkDistance": 125,
    "latencyThreshold": 68.0
  }
}
