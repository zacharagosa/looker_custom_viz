{
  "model": "void_weaver_analytics",
  "view": "sequential_ab_telemetry",
  "fields": [
    "sequential_ab_telemetry.experiment_name",
    "sequential_ab_telemetry.experiment_day",
    "sequential_ab_telemetry.stopping_verdict",
    "sequential_ab_telemetry.surface_area",
    "sequential_ab_telemetry.avg_cum_relative_lift_pct",
    "sequential_ab_telemetry.avg_always_valid_ci_lower_pct",
    "sequential_ab_telemetry.avg_always_valid_ci_upper_pct",
    "sequential_ab_telemetry.avg_upper_efficacy_bound_pct",
    "sequential_ab_telemetry.avg_lower_harm_bound_pct",
    "sequential_ab_telemetry.avg_futility_bound_pct",
    "sequential_ab_telemetry.avg_srm_p_value",
    "sequential_ab_telemetry.avg_traffic_split_pct",
    "sequential_ab_telemetry.avg_mde_target_pct",
    "sequential_ab_telemetry.avg_prob_beat_control",
    "sequential_ab_telemetry.avg_guardrail_latency_delta_ms",
