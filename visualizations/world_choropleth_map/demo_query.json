{
  "model": "thelook",
  "view": "order_items",
  "fields": [
    "users.country",
    "order_items.total_sale_price",
    "order_items.order_count"
  ],
  "sorts": [
    "order_items.total_sale_price desc"
  ],
  "limit": "500",
  "vis_config": {
    "type": "world_choropleth_map",
    "layoutMode": "natural_earth",
    "continentFocus": "all",
    "showBubbleOverlay": true,
    "showExecutiveHUD": true,
    "showSearch": true,
    "valueFormat": "compact_currency",
    "colorTheme": "google_enterprise",
    "colorScaleType": "quantile",
    "showGraticule": true,
    "showCountryBorders": true
  }
}
