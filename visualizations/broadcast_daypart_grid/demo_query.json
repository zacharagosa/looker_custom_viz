{
  "model": "tvun_media_analytics",
  "view": "ad_spot_airings",
  "fields": [
    "ad_spot_airings.airing_day_of_week",
    "ad_spot_airings.airing_hour_of_day",
    "broadcast_programming.network",
    "nielsen_ratings_markets.total_grps",
    "ad_spot_airings.total_spend_mxn"
  ],
  "sorts": [
    "ad_spot_airings.airing_day_of_week asc",
    "ad_spot_airings.airing_hour_of_day asc"
  ],
  "limit": "1500",
  "vis_config": {
    "type": "broadcast_daypart_grid",
    "viewMode": "split_view",
    "daypartPreset": "nielsen",
    "startOfWeek": "monday",
    "highlightPeaks": "top_5",
    "colorPalette": "nielsen_broadcast",
    "colorScaleMode": "quantile",
    "valueFormat": "compact_num",
    "showMarginals": true,
    "showCellValues": true,
    "showSearch": true
  }
}
