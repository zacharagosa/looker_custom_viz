{
  "model": "void_weaver_analytics",
  "view": "daily_kpis",
  "fields": [
    "mart_daily_kpis.activity_date",
    "mart_daily_kpis.dau",
    "mart_daily_kpis.arpdau",
    "mart_daily_kpis.iap_revenue_usd",
    "mart_daily_kpis.avg_session_length_sec",
    "mart_daily_kpis.avg_playtime_min_per_dau"
  ],
  "sorts": [
    "mart_daily_kpis.activity_date desc"
  ],
  "limit": "250",
  "vis_config": {
    "type": "correlation_splom_matrix",
    "layoutMode": "splom_full",
    "correlationMethod": "pearson",
    "correlationThreshold": 0.5,
    "highlightStrongCorrelations": true,
    "sortOrder": "cluster",
    "topNLimit": "all",
    "suppressNulls": true,
    "hudMode": "full",
    "dataLabelDensity": "all",
    "showRegressionLine": true,
    "showConfidenceBands": true,
    "showSearch": true,
    "colorPalette": "google_modern",
    "metricPolarity": "higher_is_better",
    "pointRadius": "3",
    "pointOpacity": "0.65",
    "fontSize": "standard",
    "valueFormat": "auto"
  }
}
