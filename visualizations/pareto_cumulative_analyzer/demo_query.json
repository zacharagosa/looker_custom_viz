{
  "model": "thelook",
  "view": "order_items",
  "fields": [
    "products.category",
    "order_items.total_sale_price",
    "order_items.order_count"
  ],
  "sorts": [
    "order_items.total_sale_price desc"
  ],
  "limit": "500",
  "vis_config": {
    "type": "pareto_cumulative_analyzer",
    "layoutMode": "classic_pareto",
    "abcThresholdA": 80,
    "abcThresholdB": 95,
    "showKpiHud": true,
    "showSearchFilter": true,
    "showThresholdLine": true,
    "showDataLabels": false,
    "maxItemsDisplay": 35,
    "curveInterpolation": "monotone",
    "colorTheme": "modern_google"
  }
}
