{
  "model": "void_weaver_analytics",
  "view": "player_onboarding_funnel",
  "fields": [
    "player_onboarding_funnel.acquisition_channel",
    "player_onboarding_funnel.funnel_stage",
    "player_onboarding_funnel.players_reached",
    "player_onboarding_funnel.total_iap_revenue_usd"
  ],
  "sorts": [
    "player_onboarding_funnel.funnel_stage asc"
  ],
  "limit": "500",
  "vis_config": {
    "type": "telemetry_conversion_funnel",
    "funnelLayout": "curved_pipeline",
    "metricMode": "primary_only",
    "pctBaseline": "step_to_step",
    "funnelOrientation": "horizontal",
    "showDropoffBadges": true,
    "showExecutiveHUD": true,
    "showStepValues": true,
    "showStepLabels": true,
    "showSearch": true,
    "colorTheme": "cyber_teal",
    "funnelGradient": "smooth",
    "curvatureIntensity": "curved",
    "stagePadding": 16,
    "minNeckWidth": 28,
    "valueFormat": "compact_num"
  }
}
