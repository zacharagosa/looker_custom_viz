{
  "model": "void_weaver_analytics",
  "view": "title_quarterly_leaderboard",
  "fields": [
    "title_quarterly_leaderboard.game_title",
    "title_quarterly_leaderboard.fiscal_quarter",
    "title_quarterly_leaderboard.gross_bookings_usd"
  ],
  "filters": {
    "title_quarterly_leaderboard.fiscal_quarter": "2026-Q2,2026-Q3"
  },
  "sorts": [
    "title_quarterly_leaderboard.game_title asc",
    "title_quarterly_leaderboard.fiscal_quarter asc"
  ],
  "limit": "500",
  "vis_config": {
    "type": "slopegraph",
    "layoutMode": "dual_axis_value",
    "targetCalculationMode": "dataset_mean",
    "referenceLineLabel": "Portfolio Mean Bookings",
    "sortOrder": "delta_desc",
    "topEntities": "all",
    "enableOtherRollup": false,
    "suppressZeroNull": true,
    "hudDensity": "full",
    "labelDensity": "all",
    "showRankBadges": true,
    "showSearch": true,
    "colorPalette": "google_enterprise",
    "metricPolarity": "higher_is_better",
    "lineCurve": "straight",
    "lineWidth": 2.5,
    "fontScale": "standard",
    "valueFormat": "compact_currency",
    "axisPadding": 180
  }
}