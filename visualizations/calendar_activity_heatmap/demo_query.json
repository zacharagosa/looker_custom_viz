{
  "model": "thelook",
  "view": "order_items",
  "fields": [
    "order_items.created_date",
    "order_items.count"
  ],
  "filters": {
    "order_items.created_date": "2024-01-01 to 2024-12-31"
  },
  "sorts": [
    "order_items.created_date asc"
  ],
  "limit": "400",
  "vis_config": {
    "type": "calendar_activity_heatmap",
    "layoutMode": "github_calendar",
    "colorPalette": "github_green",
    "cellSize": 13,
    "cellRadius": 3,
    "cellSpacing": 3,
    "showMonthLabels": true,
    "showDayLabels": true,
    "showLegend": true,
    "hudMode": "scorecard",
    "targetMode": "dataset_mean",
    "referenceLineLabel": "Daily Target",
    "anomalyThresholdPct": 130,
    "showSearch": true,
    "metricPolarity": "higher_is_better",
    "fontScale": "standard",
    "valueFormat": "compact_number"
  }
}