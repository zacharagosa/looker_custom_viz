{
  "model": "void_weaver_analytics",
  "view": "virtual_economy_flows",
  "fields": [
    "virtual_economy_flows.economy_activity",
    "virtual_economy_flows.faucet_tokens_minted",
    "virtual_economy_flows.sink_tokens_burned",
    "virtual_economy_flows.transaction_count"
  ],
  "sorts": [
    "virtual_economy_flows.faucet_tokens_minted desc"
  ],
  "limit": "500",
  "vis_config": {
    "type": "game_economy_faucet_sink",
    "layoutMode": "sankey_faucet_sink",
    "showExecutiveHUD": true,
    "faucetSinkRatioAlert": 1.15,
    "showNetVelocity": true,
    "showSearch": true,
    "colorTheme": "cyberpunk_neon",
    "currencySymbol": "🪙",
    "valueFormat": "compact_num"
  }
}
