{
  "model": "thelook",
  "view": "order_items",
  "fields": [
    "order_items.status",
    "products.category",
    "order_items.order_count",
    "order_items.total_sale_price"
  ],
  "sorts": [
    "order_items.order_count desc"
  ],
  "limit": "500",
  "vis_config": {
    "type": "mitre_attack_matrix",
    "layoutMode": "tactic_matrix",
    "showExecutiveHUD": true,
    "severityAlertThreshold": 1000,
    "showMitigationBadges": true,
    "showSearch": true,
    "colorTheme": "cyber_dark",
    "cellColorMetric": "volume",
    "showTechniqueCount": true,
    "valueFormat": "compact_num"
  }
}
