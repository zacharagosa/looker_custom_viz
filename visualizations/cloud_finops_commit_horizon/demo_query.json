{
  "model": "multicloud_focus_finops",
  "view": "gcp_focus_export",
  "fields": [
    "gcp_focus_export.commitment_discount_name",
    "gcp_focus_export.charge_period_start_week",
    "gcp_focus_export.commitment_utilization_rate",
    "gcp_focus_export.unused_commitment_breakage_cost"
  ],
  "sorts": [
    "gcp_focus_export.commitment_discount_name",
    "gcp_focus_export.charge_period_start_week"
  ],
  "limit": "5000",
  "vis_config": {
    "type": "cloud_finops_commit_horizon",
    "layoutMode": "horizon_2band",
    "horizonBands": 2,
    "hudMode": "scorecard",
    "colorPalette": "emerald_finops",
    "valueFormat": "percentage",
    "metricPolarity": "higher_is_better",
    "fontScale": "standard",
    "bandHeight": 44,
    "showZeroBaseline": true,
    "showCommitmentSummary": true,
    "showDataPoints": true,
    "showSearch": true
  },
  "filters": {
    "gcp_focus_export.commitment_discount_name": "-NULL,-No Active Commitment%"
  }
}
