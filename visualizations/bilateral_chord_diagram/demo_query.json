{
  "model": "thelook",
  "view": "order_items",
  "fields": [
    "distribution_centers.name",
    "users.state",
    "order_items.total_sale_price",
    "order_items.order_count"
  ],
  "filters": {
    "users.country": "USA",
    "order_items.created_date": "12 months"
  },
  "sorts": [
    "order_items.total_sale_price desc"
  ],
  "limit": "1500",
  "vis_config": {
    "type": "bilateral_chord_diagram",
    "vizMode": "chord",
    "sortOrder": "descending",
    "topN": "12",
    "bundleOther": true,
    "suppressNulls": true,
    "showSelfFlow": true,
    "directedFlow": true,
    "hudMode": "full",
    "dataLabelDensity": "all",
    "targetMode": "dataset_mean",
    "referenceLineLabel": "Mean Corridor Flow",
    "anomalyThresholdPct": 130,
    "showSearch": true,
    "colorPalette": "google",
    "metricPolarity": "higher_is_better",
    "fontScale": "standard",
    "valueFormat": "compact_currency",
    "arcThickness": 18,
    "ribbonOpacity": 0.65,
    "padAngle": 0.03,
    "labelStyle": "radial"
  }
}
