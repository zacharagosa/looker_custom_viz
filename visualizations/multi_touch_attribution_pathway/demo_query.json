{
  "model": "tvun_media_analytics",
  "view": "ad_spot_airings",
  "fields": [
    "broadcast_programming.network",
    "broadcast_programming.genre",
    "ad_spot_airings.daypart",
    "ad_spot_airings.total_spend_mxn",
    "nielsen_ratings_markets.total_grps",
    "ad_spot_airings.total_airing_spots"
  ],
  "sorts": [
    "ad_spot_airings.total_spend_mxn desc"
  ],
  "limit": "500",
  "vis_config": {
    "type": "multi_touch_attribution_pathway",
    "layoutMode": "attribution_comparison",
    "colorPalette": "sunset_media",
    "hudMode": "scorecard",
    "targetMode": "dataset_mean",
    "referenceLineLabel": "Target ROAS / GRP Benchmark",
    "showValueLabels": "all",
    "showLegend": true,
    "showSearch": true,
    "metricPolarity": "higher_is_better",
    "fontScale": "standard",
    "valueFormat": "compact_currency"
  }
}
