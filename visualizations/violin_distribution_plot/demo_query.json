{
  "model": "thelook",
  "view": "order_items",
  "fields": [
    "products.category",
    "products.brand",
    "order_items.total_sale_price",
    "order_items.order_count"
  ],
  "sorts": [
    "order_items.total_sale_price desc"
  ],
  "limit": "500",
  "vis_config": {
    "type": "violin_distribution_plot",
    "displayMode": "violin_box",
    "bandwidthFactor": "auto",
    "scalingMode": "independent",
    "showOutliers": true,
    "showSummaryStats": true,
    "showSearch": true,
    "valueFormat": "compact_currency",
    "colorPalette": "google_modern",
    "fillOpacity": "0.75",
    "boxPlotWidth": "medium",
    "showGridlines": true,
    "showMeanMarker": true
  }
}
