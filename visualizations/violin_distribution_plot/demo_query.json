{
  "model": "thelook",
  "view": "order_items",
  "fields": [
    "products.category",
    "order_items.id",
    "order_items.sale_price"
  ],
  "filters": {
    "products.category": "Jeans,Sweaters,Outerwear & Coats,Accessories,Tops & Tees,Dresses,Swim,Suits",
    "order_items.sale_price": "NOT NULL"
  },
  "sorts": [
    "order_items.id asc"
  ],
  "limit": "3000",
  "vis_config": {
    "type": "violin_distribution_plot",
    "displayMode": "violin_box",
    "bandwidthFactor": "auto",
    "scalingMode": "independent",
    "yAxisScope": "robust",
    "showOutliers": true,
    "showSummaryStats": true,
    "showSearch": true,
    "valueFormat": "compact_currency",
    "colorPalette": "google_modern",
    "fillOpacity": "0.75",
    "boxPlotWidth": "medium",
    "showGridlines": true,
    "showMeanMarker": true
  }
}
