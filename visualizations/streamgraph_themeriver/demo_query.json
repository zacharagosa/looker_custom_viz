{
  "model": "thelook",
  "view": "order_items",
  "fields": [
    "order_items.created_month",
    "products.category",
    "order_items.total_sale_price"
  ],
  "filters": {
    "order_items.created_date": "24 months"
  },
  "sorts": [
    "order_items.created_month asc",
    "order_items.total_sale_price desc"
  ],
  "limit": "1500",
  "vis_config": {
    "type": "streamgraph_themeriver",
    "baselineMode": "silhouette",
    "curveInterpolation": "curveCatmullRom",
    "sortOrder": "insideOut",
    "topNLimit": "12",
    "showOtherRollup": true,
    "suppressNulls": true,
    "hudMode": "full",
    "dataLabelDensity": "all",
    "targetMode": "dataset_mean",
    "targetLabel": "Category Mean Volume",
    "anomalyThreshold": 25,
    "highlightTargetBreaches": true,
    "showCrosshair": true,
    "showSearch": true,
    "colorPalette": "google_modern",
    "metricPolarity": "higher_is_better",
    "streamOpacity": "0.85",
    "strokeWidth": "1",
    "fontSize": "standard",
    "valueFormat": "compact_currency"
  }
}
