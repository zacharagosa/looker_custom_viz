{
  "model": "void_weaver_analytics",
  "view": "studio_release_roadmap",
  "fields": [
    "studio_release_roadmap.task_name",
    "studio_release_roadmap.workstream",
    "studio_release_roadmap.task_status",
    "studio_release_roadmap.owner_lead",
    "studio_release_roadmap.priority_tier",
    "studio_release_roadmap.start_date",
    "studio_release_roadmap.end_date",
    "studio_release_roadmap.completion_pct",
    "studio_release_roadmap.total_budget_allocated_usd",
    "studio_release_roadmap.projected_revenue_lift_usd"
  ],
  "sorts": [
    "studio_release_roadmap.workstream asc",
    "studio_release_roadmap.start_date asc"
  ],
  "limit": "500",
  "vis_config": {
    "type": "gantt_milestones_timeline",
    "layout_mode": "gantt_progress",
    "time_scale": "auto",
    "group_by_swimlane": true,
    "sort_order": "start_asc",
    "show_milestones": true,
    "show_executive_hud": true,
    "show_search_bar": true,
    "show_today_line": true,
    "show_task_labels": true,
    "color_palette": "google",
    "heatmap_metric_mode": "gradient",
    "bar_corner_radius": 5,
    "bar_height": 22,
    "show_gridlines": true,
    "theme_mode": "light"
  }
}
