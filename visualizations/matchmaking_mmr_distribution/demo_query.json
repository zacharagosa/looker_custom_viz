{
  "model": "void_weaver_analytics",
  "view": "matchmaking_mmr_telemetry",
  "fields": [
    "matchmaking_mmr_telemetry.mmr_bucket",
    "matchmaking_mmr_telemetry.active_players",
    "matchmaking_mmr_telemetry.avg_queue_wait_sec",
    "matchmaking_mmr_telemetry.avg_win_rate_pct"
  ],
  "sorts": [
    "matchmaking_mmr_telemetry.mmr_bucket asc"
  ],
  "limit": "500",
  "vis_config": {
    "type": "matchmaking_mmr_distribution",
    "layoutMode": "gaussian_bell",
    "showExecutiveHUD": true,
    "latencySlaThreshold": 120,
    "showGaussianFit": true,
    "showRankTiers": true,
    "showSearch": true,
    "colorTheme": "modern_slate",
    "curveSmoothing": "monotone",
    "showGridlines": true,
    "valueFormat": "compact_num"
  }
}
